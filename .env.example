# === DEMOS ===
NEXT_PUBLIC_DEMO_FERROPOS_URL=https://ferropos-system.vercel.app/login
NEXT_PUBLIC_DEMO_RESTAURANTE_URL=https://restaurant-pos-system-lilac.vercel.app/login

# === CONTACTO ===
NEXT_PUBLIC_WHATSAPP_NUMBER=51987454769
NEXT_PUBLIC_CONTACT_EMAIL=factusys.peru@gmail.com

# === FACEBOOK (contacto asistido, no API directa) ===
# Facebook no expone API pública para enviar mensajes a páginas de terceros.
# El CRM usa contacto manual asistido (abre WhatsApp/Facebook en el navegador).
# Estas variables son para referencia futura cuando se integre la Graph API.
FACEBOOK_PAGE_ID=
FACEBOOK_ACCESS_TOKEN=

# === PROSPECT ENRICHMENT ===
# El enriquecedor de prospectos busca datos públicos (email, redes sociales, web)
# a partir del nombre del negocio y ciudad. En modo mock genera datos simulados.
# Próximamente: integración con Google Custom Search, Hunter.io, etc.
NEXT_PUBLIC_ENRICH_PROVIDER=mock

# === CRM STORAGE (local | supabase) ===
NEXT_PUBLIC_CRM_STORAGE=local
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# === PROSPECT SEARCH (mock | google_places | serpapi) ===
# mock = datos demo (sin API key)
# google_places = requiere GOOGLE_PLACES_API_KEY
# serpapi = requiere SERPAPI_API_KEY (Google Maps via SerpApi)
NEXT_PUBLIC_PROSPECT_SEARCH_PROVIDER=mock
GOOGLE_PLACES_API_KEY=
SERPAPI_API_KEY=

# === WHATSAPP (OPENWA BRIDGE) ===
# OpenWA es un bridge para enviar WhatsApp desde el servidor
# Más info: docs/OPENWA_CRM_BRIDGE.md
OPENWA_API_URL=http://localhost:2785/api
OPENWA_API_KEY=

# === POSTGRESQL (CRM Database) ===
# Dejar vacío para modo desconectado
DATABASE_URL=postgresql://user:password@localhost:5432/factusys_crm

# === EMAIL (SMTP) ===
# Si SMTP no está configurado, el CRM opera en modo simulación
EMAIL_FROM=factusys.peru@gmail.com
EMAIL_PROVIDER=smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
